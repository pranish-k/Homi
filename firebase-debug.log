[debug] [2025-10-26T22:37:10.043Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/homi-ios/rulesets {"name":"projects/homi-ios/rulesets/edb5843a-d1e1-4855-a224-94b975a3135a","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // Helper functions\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isOwner(userId) {\n      return isAuthenticated() && request.auth.uid == userId;\n    }\n\n    function isMember(houseId) {\n      return isAuthenticated() &&\n        request.auth.uid in get(/databases/$(database)/documents/houses/$(houseId)).data.memberIds;\n    }\n\n    function isHouseAdmin(houseId) {\n      return isAuthenticated() &&\n        get(/databases/$(database)/documents/houses/$(houseId)/members/$(request.auth.uid)).data.role == 'admin';\n    }\n\n    // Rate limiting helper (basic - consider using Cloud Functions for robust rate limiting)\n    function notTooManyRequests() {\n      // This is a simplified check. For production, implement server-side rate limiting\n      return true;\n    }\n\n    // Users collection\n    match /users/{userId} {\n      // Users can read their own data\n      allow read: if isOwner(userId);\n\n      // Users can create their own profile during signup\n      allow create: if isOwner(userId) &&\n        request.resource.data.keys().hasAll(['id', 'displayName', 'authProviders', 'createdAt', 'lastSeen']) &&\n        request.resource.data.id == userId;\n\n      // Users can update their own data\n      allow update: if isOwner(userId);\n\n      // No one can delete user profiles (handle via Cloud Functions if needed)\n      allow delete: if false;\n    }\n\n    // Houses collection\n    match /houses/{houseId} {\n      // Members can read house data\n      allow read: if isMember(houseId);\n\n      // Authenticated users can create houses\n      allow create: if isAuthenticated() &&\n        request.resource.data.createdBy == request.auth.uid &&\n        request.resource.data.memberIds.hasAll([request.auth.uid]) &&\n        request.resource.data.memberCount == 1 &&\n        request.resource.data.inviteCode.size() == 8;\n\n      // Only house admin or creator can update house\n      allow update: if isMember(houseId) &&\n        (isHouseAdmin(houseId) || resource.data.createdBy == request.auth.uid);\n\n      // Only creator can delete house (when leaving as last member)\n      allow delete: if isAuthenticated() && resource.data.createdBy == request.auth.uid;\n\n      // House members subcollection\n      match /members/{memberId} {\n        // Members can read all member data in their house\n        allow read: if isMember(houseId);\n\n        // Only house admins can add members (via join flow)\n        allow create: if isMember(houseId);\n\n        // Members can update their own profile in the house\n        allow update: if isOwner(memberId) || isHouseAdmin(houseId);\n\n        // Only admins can remove members\n        allow delete: if isHouseAdmin(houseId) || isOwner(memberId);\n      }\n\n      // Expenses subcollection\n      match /expenses/{expenseId} {\n        // Members can read all expenses in their house\n        allow read: if isMember(houseId);\n\n        // Members can create expenses\n        allow create: if isMember(houseId) &&\n          request.resource.data.createdBy == request.auth.uid &&\n          request.resource.data.houseId == houseId &&\n          request.resource.data.amount > 0 &&\n          request.resource.data.amount <= 1000000;\n\n        // Creator or payer can update expense\n        allow update: if isMember(houseId) &&\n          (resource.data.createdBy == request.auth.uid ||\n           resource.data.paidBy == request.auth.uid);\n\n        // Only creator can delete expense\n        allow delete: if isMember(houseId) && resource.data.createdBy == request.auth.uid;\n      }\n\n      // Payments subcollection\n      match /payments/{paymentId} {\n        // Members can read all payments in their house\n        allow read: if isMember(houseId);\n\n        // Members can create payments (paying someone)\n        allow create: if isMember(houseId) &&\n          request.resource.data.fromUserId == request.auth.uid &&\n          request.resource.data.houseId == houseId &&\n          request.resource.data.amount > 0;\n\n        // No one can update or delete payments (immutable record)\n        allow update, delete: if false;\n      }\n\n      // Chores subcollection\n      match /chores/{choreId} {\n        // Members can read all chores in their house\n        allow read: if isMember(houseId);\n\n        // Members can create chores\n        allow create: if isMember(houseId) &&\n          request.resource.data.createdBy == request.auth.uid &&\n          request.resource.data.houseId == houseId &&\n          request.resource.data.points >= 0 &&\n          request.resource.data.points <= 1000;\n\n        // Creator or assignee can update chore\n        allow update: if isMember(houseId) &&\n          (resource.data.createdBy == request.auth.uid ||\n           resource.data.assignedTo == request.auth.uid);\n\n        // Only creator can delete chore\n        allow delete: if isMember(houseId) && resource.data.createdBy == request.auth.uid;\n      }\n\n      // Messages subcollection\n      match /messages/{messageId} {\n        // Members can read all messages in their house\n        allow read: if isMember(houseId);\n\n        // Members can create messages\n        allow create: if isMember(houseId) &&\n          request.resource.data.senderId == request.auth.uid &&\n          request.resource.data.houseId == houseId &&\n          request.resource.data.content.size() > 0 &&\n          request.resource.data.content.size() <= 5000;\n\n        // Members can update messages for:\n        // 1. Sender can edit content within 15 minutes\n        // 2. Any member can update readBy array to mark as read\n        allow update: if isMember(houseId) &&\n          (\n            // Sender editing content within 15 minutes\n            (resource.data.senderId == request.auth.uid &&\n             request.time < resource.data.timestamp + duration.value(15, 'm')) ||\n            // Member marking message as read (only readBy field changes)\n            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&\n             request.auth.uid in request.resource.data.readBy &&\n             !(request.auth.uid in resource.data.readBy))\n          );\n\n        // Only sender can delete their own message\n        allow delete: if isMember(houseId) && resource.data.senderId == request.auth.uid;\n      }\n\n      // Locations subcollection\n      match /locations/{locationId} {\n        // Members can read all locations in their house\n        allow read: if isMember(houseId);\n\n        // Users can only write their own location\n        allow create, update: if isMember(houseId) &&\n          locationId == request.auth.uid &&\n          request.resource.data.userId == request.auth.uid;\n\n        // Users can delete their own location\n        allow delete: if isOwner(locationId);\n      }\n    }\n\n    // Invites collection\n    match /invites/{inviteCode} {\n      // Authenticated users can read invite codes to join houses\n      allow read: if isAuthenticated() && notTooManyRequests();\n\n      // Only the system can create invite codes (during house creation)\n      // In production, this should be handled by Cloud Functions\n      allow create: if isAuthenticated();\n\n      // Only the system can update invite usage\n      allow update: if isAuthenticated();\n\n      // Only house creators can delete invite codes\n      allow delete: if isAuthenticated() &&\n        get(/databases/$(database)/documents/houses/$(resource.data.houseId)).data.createdBy == request.auth.uid;\n    }\n\n    // Conversations collection (for direct messaging)\n    match /conversations/{conversationId} {\n      // Users can read conversations they're part of\n      allow read: if isAuthenticated() &&\n        request.auth.uid in resource.data.participantIds;\n\n      // Users can create conversations they're part of\n      allow create: if isAuthenticated() &&\n        request.auth.uid in request.resource.data.participantIds &&\n        request.resource.data.participantIds.size() == 2;\n\n      // Participants can update conversation (last message, unread counts)\n      allow update: if isAuthenticated() &&\n        request.auth.uid in resource.data.participantIds;\n\n      // Participants can delete conversations\n      allow delete: if isAuthenticated() &&\n        request.auth.uid in resource.data.participantIds;\n    }\n\n    // Direct Messages collection\n    match /directMessages/{conversationId}/messages/{messageId} {\n      // Users can read messages in conversations they're part of\n      allow read: if isAuthenticated() &&\n        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;\n\n      // Users can send messages to conversations they're part of\n      allow create: if isAuthenticated() &&\n        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&\n        request.resource.data.senderId == request.auth.uid &&\n        request.resource.data.content.size() > 0 &&\n        request.resource.data.content.size() <= 5000;\n\n      // Users can update read status on messages\n      allow update: if isAuthenticated() &&\n        request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;\n\n      // Only sender can delete their own messages\n      allow delete: if isAuthenticated() &&\n        resource.data.senderId == request.auth.uid;\n    }\n\n    // Nudges collection\n    match /nudges/{nudgeId} {\n      // Users can read nudges sent to or from them\n      allow read: if isAuthenticated() &&\n        (resource.data.fromUserId == request.auth.uid ||\n         resource.data.toUserId == request.auth.uid);\n\n      // Users can send nudges (create)\n      allow create: if isAuthenticated() &&\n        request.resource.data.fromUserId == request.auth.uid &&\n        request.resource.data.houseId != null;\n\n      // No one can update nudges (immutable record)\n      allow update: if false;\n\n      // Users can delete nudges they sent\n      allow delete: if isAuthenticated() &&\n        resource.data.fromUserId == request.auth.uid;\n    }\n\n    // Deny all other access by default\n    match /{document=**} {\n      allow read, write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2025-10-26T22:37:10.004639Z","metadata":{"services":["cloud.firestore"]}}
